{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moka Canvas",
  "version": "0.2.0",
  "identifier": "app.mokacanvas",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist": "web",
      "icons/moka-file.icns": "moka-file.icns",
      "icons/moka-file.ico": "moka-file.ico"
    },
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 240,
          "y": 215
        },
        "applicationFolderPosition": {
          "x": 540,
          "y": 215
        }
      }
    },
    "windows": {
      "nsis": {
        "template": "installer/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/welcome.bmp",
        "uninstallerHeaderImage": "installer/uninstall-header.bmp"
      }
    }
  }
}
